{
  "$schema": "./tokens.schema (informal) — machine source of truth for the LUMEN design language",
  "meta": {
    "name": "LUMEN design language",
    "version": "1.0.0",
    "theme": "dark",
    "extractedFrom": [
      "benchmark.html",
      "tasks/skill-deterministic-checker/README.html",
      "tasks/skill-workspace-optimizer/README.html"
    ],
    "note": "Values were EXTRACTED from the dark theme already in use across the repo, not invented. Edit here, then regenerate tokens.css with scripts/gen-css.mjs."
  },

  "color": {
    "bg": "#0b0f14",
    "bg2": "#0d131b",
    "panel": "#121821",
    "panel2": "#161e29",
    "inset": "#0e141c",
    "line": "#243140",
    "ink": "#e6edf3",
    "ink2": "#cdd9e5",
    "muted": "#9fb0c0",
    "faint": "#6f8298",

    "blue": "#58a6ff",
    "violet": "#a371f7",
    "green": "#3fb950",
    "amber": "#d29922",
    "red": "#f85149",

    "blueDeep": "#1f6feb",
    "violetDeep": "#6e40c9",
    "greenDeep": "#238636",
    "good": "#2ea043",
    "mid": "#bb8009",
    "bad": "#cf383f",

    "blueText": "#79c0ff",
    "greenText": "#56d364",
    "amberText": "#e3b341",
    "redText": "#ff7b72",
    "faintText": "#b1bac4"
  },

  "severity": {
    "p0": { "label": "P0", "rail": "#f85149", "text": "#ff7b72", "bg": "rgba(248,81,73,.16)", "border": "rgba(248,81,73,.4)" },
    "p1": { "label": "P1", "rail": "#d29922", "text": "#e3b341", "bg": "rgba(210,153,34,.16)", "border": "rgba(210,153,34,.4)" },
    "p2": { "label": "P2", "rail": "#58a6ff", "text": "#79c0ff", "bg": "rgba(88,166,255,.14)", "border": "rgba(88,166,255,.4)" },
    "p3": { "label": "P3", "rail": "#6f8298", "text": "#b1bac4", "bg": "rgba(139,148,158,.14)", "border": "rgba(139,148,158,.35)" }
  },

  "surface": {
    "page": "linear-gradient(180deg,#0b0f14,#0d131b)",
    "panel": "#121821",
    "panelRaised": "#161e29",
    "inset": "#0e141c",
    "hover": "rgba(88,166,255,.04)",
    "lineSoft": "rgba(36,49,64,.5)"
  },

  "layout": {
    "maxWidth": "1080px",
    "maxWidthNarrow": "1000px",
    "breakpoint": "760px",
    "breakpointWide": "740px"
  },

  "space": {
    "0": "0",
    "px": "1px",
    "1": "2px",
    "2": "4px",
    "3": "6px",
    "4": "8px",
    "5": "10px",
    "6": "12px",
    "7": "14px",
    "8": "16px",
    "9": "18px",
    "10": "20px",
    "11": "22px",
    "12": "26px",
    "13": "40px",
    "14": "46px",
    "15": "80px"
  },

  "radius": {
    "xs": "5px",
    "sm": "6px",
    "md": "7px",
    "lg": "10px",
    "xl": "12px",
    "2xl": "14px",
    "pill": "20px",
    "round": "50%"
  },

  "type": {
    "fontSans": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif",
    "fontMono": "ui-monospace,SFMono-Regular,Menlo,monospace",
    "baseSize": "15px",
    "baseLine": "1.6",
    "scale": {
      "h1": { "size": "30px", "weight": "700", "tracking": "-.5px", "line": "1.2" },
      "h2": { "size": "21px", "weight": "600", "tracking": "0", "line": "1.3" },
      "h3": { "size": "16px", "weight": "600", "tracking": "0", "line": "1.4" },
      "body": { "size": "15px", "weight": "400", "tracking": "0", "line": "1.6" },
      "small": { "size": "14px", "weight": "400", "tracking": "0", "line": "1.6" },
      "meta": { "size": "13px", "weight": "400", "tracking": "0", "line": "1.5" },
      "code": { "size": "13px", "weight": "400", "tracking": "0", "line": "1.4" },
      "micro": { "size": "11px", "weight": "700", "tracking": ".5px", "line": "1.4" },
      "label": { "size": "12px", "weight": "600", "tracking": ".4px", "line": "1.4" }
    }
  },

  "component": {
    "gauge": {
      "bg": "#121821",
      "border": "#243140",
      "radius": "14px",
      "pad": "20px",
      "numSize": "46px",
      "numWeight": "700",
      "labelColor": "#9fb0c0",
      "barTrack": "#0e141c",
      "barHeight": "7px",
      "fillAi": "linear-gradient(90deg,#1f6feb,#58a6ff)",
      "fillDet": "linear-gradient(90deg,#6e40c9,#a371f7)",
      "fillComp": "linear-gradient(90deg,#238636,#3fb950)",
      "deltaUpBg": "rgba(63,185,80,.12)",
      "deltaUpText": "#3fb950",
      "deltaUpBorder": "rgba(63,185,80,.3)"
    },
    "badge": {
      "radius": "6px",
      "pad": "2px 9px",
      "size": "11px",
      "weight": "700",
      "tracking": ".5px"
    },
    "findingCard": {
      "bg": "#121821",
      "border": "#243140",
      "radius": "11px",
      "pad": "14px 16px",
      "railWidth": "4px"
    },
    "card": {
      "bg": "#121821",
      "border": "#243140",
      "radius": "12px",
      "pad": "16px 18px",
      "accentWidth": "3px"
    },
    "table": {
      "headColor": "#9fb0c0",
      "headSize": "12.5px",
      "headWeight": "600",
      "cellPad": "9px 11px",
      "rowLine": "#243140",
      "rowHover": "rgba(88,166,255,.04)",
      "fontSize": "14px"
    },
    "pill": {
      "border": "#243140",
      "color": "#9fb0c0",
      "radius": "20px",
      "pad": "3px 11px",
      "size": "12px"
    },
    "scoreChip": {
      "radius": "7px",
      "pad": "2px 8px",
      "weight": "700",
      "size": "13px",
      "high": { "bg": "rgba(46,160,67,.16)", "text": "#56d364", "border": "rgba(46,160,67,.35)" },
      "mid": { "bg": "rgba(187,128,9,.16)", "text": "#e3b341", "border": "rgba(187,128,9,.35)" },
      "low": { "bg": "rgba(207,56,63,.16)", "text": "#ff7b72", "border": "rgba(207,56,63,.35)" }
    },
    "lead": {
      "bg": "#121821",
      "border": "#243140",
      "accent": "#58a6ff",
      "accentWidth": "3px",
      "radius": "10px",
      "pad": "16px 18px"
    },
    "code": {
      "bg": "#0e141c",
      "border": "#243140",
      "radius": "5px",
      "color": "#cdd9e5"
    }
  }
}
